# Copy to .env.local for local development only. Never commit real values.
# Production values belong in the Cloudflare Worker settings (secrets), not in this repo.

# Admin keys (send as the x-admin-key header). Use long random strings, at least 32 characters.
ADMIN_API_KEY=
STAFF_ADMIN_KEY=

# Encrypts stored social-media tokens. Long random string.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Optional: override the public site address (defaults to https://bailamos-waldcafe.de).
NEXT_PUBLIC_SITE_URL=

# Outgoing e-mail (IONOS SMTP).
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Owner alerts on Telegram (optional: bookings still work without them).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI text suggestions in the admin (optional).
OPENAI_API_KEY=
OPENAI_MODEL=

# Social publishing (optional).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
